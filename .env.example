# Copy to .env and fill in the two blanks from the team sheet.
#   cp .env.example .env && chmod 600 .env
# Load with:  set -a; . .env; set +a     (run from the repo root)
#
# Values are left EMPTY on purpose. A "<placeholder>" here would break
# `. .env` in zsh, which reads < as a redirection.

LITELLM_PROXY_URL=
LITELLM_PROXY_KEY=
AGENT_MODEL=azure_ai/claude-haiku-4-5

# Optional: only needed instead of `sia login`.
SIA_TOKEN=
